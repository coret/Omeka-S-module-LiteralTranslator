{
    "name": "coret/omeka-s-module-literal-translator",
    "type": "library",
    "description": "Omeka S module adding a translate button to every literal value on the resource form: pick a target language and the DeepL translation is added as a new value with its language tag.",
    "license": "GPL-3.0-or-later",
    "authors": [
        {
            "name": "Bob Coret",
            "homepage": "https://github.com/coret"
        }
    ],
    "homepage": "https://github.com/coret/Omeka-S-module-LiteralTranslator",
    "support": {
        "issues": "https://github.com/coret/Omeka-S-module-LiteralTranslator/issues",
        "forum": "https://forum.omeka.org/"
    },
    "keywords": [
        "Omeka S",
        "Omeka S module",
        "translation",
        "DeepL",
        "multilingual"
    ],
    "require": {
        "php": ">=8.1"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.8.0"
    },
    "autoload": {
        "psr-4": {
            "LiteralTranslator\\": "src/"
        }
    },
    "config": {
        "platform": {
            "php": "8.1"
        }
    }
}
